doctype html
html
  head
    title= zone.name
    link(rel='stylesheet', href='/style.css')
  body
    include partials/nav.pug

    .container
      a.back-link(href='/') ← Back to all zones
      h1= zone.name
      p.subtitle Capacity: #{zone.capacity} units &nbsp;•&nbsp; Distance from dock: #{zone.distanceFromDock}m

      .card
        table
          thead
            tr
              th SKU
              th Name
              th Category
              th Quantity
              th Demand Score
              th Last Moved
          tbody
            each item in items
              tr
                td= item.sku
                td= item.name
                td= item.category
                td= item.quantity
                td= item.demandScore
                td= item.lastMovedAt.toDateString()
