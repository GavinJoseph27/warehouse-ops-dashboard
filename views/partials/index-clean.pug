doctype html
html
  head
    title Warehouse Ops Dashboard
    link(rel='stylesheet', href='/style.css')
  body
    include partials/nav.pug

    .container
      h1 Warehouse Ops Dashboard
      p.subtitle= `${zones.length} zones tracked`

      .grid
        each zone in zones
          //- color-code the fill bar so problem zones are visible at a glance
          - var barClass = zone.percentFull > 90 ? 'over' : (zone.percentFull < 20 ? 'under' : 'normal')
          a.zone-card(href=`/zone/${zone._id}`)
            h3= zone.name
            p #{zone.used} / #{zone.capacity} units (#{zone.percentFull}%)
            p #{zone.itemCount} SKUs
            .bar-bg
              .bar-fill(class=barClass, style=`width: ${Math.min(zone.percentFull, 100)}%`)
